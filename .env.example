# Copy to .env.local for local dev (never commit real values).

# Supabase — public keys are safe in the static GitHub Pages build (RLS-limited).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Maintainer / CI only — never prefix with NEXT_PUBLIC_ and never add to pages.yml.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Local maintainer scripts (language-notes.ts, process-language-notes.ts).
# In GitHub Actions, language-notes-process.yml injects these from repository secrets.
# SUPABASE_URL=https://your-project.supabase.co

# Parent-video TTS (local / Cloud Agent only — not used in Pages deploy).
# FAL_KEY=

# Optional feedback email shown on language log pages.
# NEXT_PUBLIC_FEEDBACK_EMAIL=you@example.com
